[WebUI]
# 将内部监听端口改为 6970，避免潜在冲突
Port = 6970
Host = "0.0.0.0"

[qBit]
# 使用 Servarr 内网容器名通讯
Host = "${QBITTORRENT_HOSTNAME}"
Port = ${QBITTORRENT_PORT}
UserName = "${TARGET_USER}"
Password = "${TARGET_PASS}"
# 管理这些分类下的种子（非 Arr 实例管理的分类）
# 注意：此处列出的分类走 [qBit.CategorySeeding] 策略，不具备 MaximumDeletablePercentage 保护
ManagedCategories = ["prowlarr", "whisparr"]

# 分类托管模式的做种与失速策略
# 仅对 ManagedCategories 中列出的分类生效，不影响 Sonarr/Radarr 等 Arr 实例
[qBit.CategorySeeding]
# 【禁用失速删除】分类托管模式不支持 MaximumDeletablePercentage（进度保护），
# 如果启用 StalledDelay，失速种子会被无条件删除，无论下载进度多少。
# 设为 -1 彻底禁用，由用户手动管理这些分类下的死种。
StalledDelay = -1
# 种子添加后的免疫期（秒），在此期间不会被判定为失速
IgnoreTorrentsYoungerThan = 600

[Settings]
# 全局扫描间隔（秒）
LoopSleepTimer = 300
# 指向容器内的下载挂载路径
CompletedDownloadFolder = "/downloads"

# ============================================================
# Sonarr 监控配置
# ============================================================
[Sonarr-TV]
Managed = true
URI = "http://${SONARR_HOSTNAME}:${SONARR_PORT}"
APIKey = "<YOUR_SONARR_API_KEY>"
Category = "tv-sonarr"
ReSearch = true          # 开启基础重搜功能

[Sonarr-TV.Torrent]
# 【缓冲设置】给磁力链接 10 分钟时间去寻找 Peer 获取元数据
IgnoreTorrentsYoungerThan = 600

# 不要自动删除速度慢的种子文件
DoNotRemoveSlow = true

# 【失速时间】在 10 分钟缓冲后，如果持续 30 分钟无速度，则判定为失速并删除
StalledDelay = 30

# 【换种策略】设为 false，让 Arr 通过自然重试逻辑去换种（避免 API 爆发）
ReSearchStalled = false

# 【冷门资源保护】如果下载进度已经超过 10%，则不再自动删除（保护定时上线的上传者）
MaximumDeletablePercentage = 0.1

# ============================================================
# Radarr 监控配置
# ============================================================
[Radarr-Movies]
Managed = true
URI = "http://${RADARR_HOSTNAME}:${RADARR_PORT}"
APIKey = "<YOUR_RADARR_API_KEY>"
Category = "radarr"
ReSearch = true

[Radarr-Movies.Torrent]
DoNotRemoveSlow = true
StalledDelay = 30
ReSearchStalled = false
IgnoreTorrentsYoungerThan = 600
MaximumDeletablePercentage = 0.1
